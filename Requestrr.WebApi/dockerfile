# syntax=docker/dockerfile:1

# =============================================================================
# Controlarr (Requestrr) - Production Dockerfile for Unraid
# =============================================================================

# --- Build arguments ---
ARG DOTNET_VERSION=6.0
ARG NODE_VERSION=18

# =============================================================================
# Stage 1: Build Frontend (React)
# =============================================================================
FROM node:${NODE_VERSION}-alpine AS frontend-builder

WORKDIR /app/ClientApp

# Copy package files first for better caching
COPY Requestrr.WebApi/ClientApp/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy frontend source
COPY Requestrr.WebApi/ClientApp/ ./

# Build production frontend
RUN npm run build

# =============================================================================
# Stage 2: Build Backend (.NET)
# =============================================================================
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-alpine AS backend-builder

WORKDIR /src

# Copy csproj and restore dependencies (cached layer)
COPY Requestrr.WebApi/Requestrr.WebApi.csproj ./Requestrr.WebApi/
WORKDIR /src/Requestrr.WebApi
RUN dotnet restore --runtime linux-musl-x64

# Copy backend source
WORKDIR /src
COPY Requestrr.WebApi/ ./Requestrr.WebApi/

# Copy built frontend from previous stage (this skips npm in dotnet publish)
COPY --from=frontend-builder /app/ClientApp/build ./Requestrr.WebApi/ClientApp/build/

# Build and publish
WORKDIR /src/Requestrr.WebApi
RUN dotnet publish -c Release -o /app/publish \
    --runtime linux-musl-x64 \
    --self-contained false \
    --no-restore

# =============================================================================
# Stage 3: Production Runtime
# =============================================================================
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-alpine AS production

# Labels for Unraid
LABEL maintainer="RubenDijk" \
      org.opencontainers.image.title="Controlarr" \
      org.opencontainers.image.description="Discord bot for requesting media via Sonarr, Radarr, Overseerr, and more" \
      org.opencontainers.image.source="https://github.com/RubenDijk/controlarr" \
      org.opencontainers.image.version="2.1.9"

# Install timezone data and create user
RUN apk add --no-cache \
    tzdata \
    icu-libs \
    && addgroup -S controlarr \
    && adduser -S -G controlarr controlarr

WORKDIR /app

# Copy published application
COPY --from=backend-builder /app/publish .

# Create config directory and set permissions
RUN mkdir -p /app/config \
    && chown -R controlarr:controlarr /app

# Volume for persistent configuration
VOLUME ["/app/config"]

# Switch to non-root user
USER controlarr

# Expose port
EXPOSE 4545

# Environment variables
ENV ASPNETCORE_URLS=http://+:4545 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    TZ=Europe/Amsterdam

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4545/ || exit 1

# Start application
ENTRYPOINT ["dotnet", "Requestrr.WebApi.dll", "-c", "/app/config"]
